AEM_BASE_URL=http://localhost:4502
AEM_USERNAME=admin
AEM_PASSWORD=admin

# Read access roots.
AEM_ALLOWED_ROOTS=/content,/conf

# Write operations are disabled until explicitly enabled.
AEM_WRITE_ENABLED=false

# Even when enabled, writes are limited to these roots.
# For learning, point this to a disposable branch only.
AEM_WRITE_ROOTS=/content/mcp-poc

# Optional comma-separated add-component allowlist. Empty allows any resource type.
AEM_COMPONENT_ALLOWED_RESOURCE_TYPES=

# Empty publication roots fall back to AEM_WRITE_ROOTS.
AEM_PUBLISH_ALLOWED_ROOTS=/content/mcp-poc
AEM_DAM_READ_ROOTS=/content/dam
AEM_DAM_WRITE_ROOTS=/content/dam
AEM_MAX_ASSET_SEARCH_LIMIT=200
AEM_MAX_ASSET_USAGE_LIMIT=500
AEM_MAX_ASSET_UPLOAD_BYTES=26214400
AEM_ALLOWED_ASSET_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf
# Read-only previews are fetched by MCP; private AEM URLs and credentials are never returned.
AEM_PREVIEW_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf
AEM_MAX_PREVIEW_BYTES=5242880
AEM_COMPONENT_DIALOG_MAX_INHERITANCE_DEPTH=10

AEM_TIMEOUT_SECONDS=20
AEM_VERIFY_SSL=false

# Transport. run_server.py remains stdio; run_http_server.py uses the HTTP values.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp

# HTTP mode refuses to start with an empty token or this placeholder.
MCP_HTTP_AUTH_ENABLED=true
MCP_HTTP_BEARER_TOKEN=change-me

# Authentication mode. If omitted, legacy MCP_HTTP_AUTH_ENABLED behavior is preserved.
# Production: oauth. Development: none or static_bearer.
MCP_AUTH_MODE=static_bearer
MCP_OAUTH_ENABLED=false
MCP_PUBLIC_BASE_URL=http://127.0.0.1:8000
MCP_OAUTH_ISSUER=https://accounts.google.com
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_REQUIRED_SCOPES=openid,email,profile
# Defaults to MCP_OAUTH_CLIENT_ID when empty.
MCP_OAUTH_AUDIENCE=

# Comma-separated exact values; :* permits any port for the named host/origin.
# Add the public reverse-proxy hostname and HTTPS origin before remote use.
MCP_HTTP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
MCP_HTTP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*
MCP_HTTP_MAX_BODY_BYTES=1048576
MCP_HTTP_LOG_LEVEL=INFO
MCP_AUDIT_LOG_ENABLED=true
MCP_AUDIT_LOG_LEVEL=INFO

# Optional downstream Adobe-hosted AEM MCP proof of concept. Local AEM is
# unchanged while this is false.
ADOBE_MCP_ENABLED=true
ADOBE_MCP_SERVER_URL=https://mcp.adobeaemcloud.com/adobe/mcp/cloudmanager
# Exact upstream names only. Empty means call_tool is denied.
ADOBE_MCP_ALLOWED_TOOLS=
ADOBE_MCP_SESSION_STORE=memory
# Must exactly match the redirect URI approved/allowlisted by Adobe.
ADOBE_MCP_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/adobe-mcp/oauth/callback
# Development only. The current static HTTP bearer has no per-user subject.
# THIS MODE IS NOT MULTI-USER SAFE.
ADOBE_MCP_SINGLE_DEVELOPER_MODE=true
# Set only after an authenticated tools/list proves the read-only upstream name.
ADOBE_MCP_ENVIRONMENTS_TOOL=
ADOBE_MCP_CONNECT_TIMEOUT_SECONDS=30
